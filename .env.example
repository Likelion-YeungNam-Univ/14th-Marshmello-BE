BUILD_ID=local-development
APP_PORT=8080
APP_UID=1000
APP_GID=1000
APP_IMAGE=marshmello-was:local
POSTGRES_DB=marshmello
POSTGRES_USER=marshmello
POSTGRES_PASSWORD_FILE=.secrets/postgres_password

# S3 (credentials come from the EC2 IAM role)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# OAuth2 / OIDC
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid,email

# Authorization
APP_ALLOWED_EMAILS=
APP_ALLOWED_EMAIL_DOMAINS=
APP_ALLOWED_SUBJECTS=
APP_REQUIRE_VERIFIED_EMAIL=true
# Explicit HTTPS production origin(s) and post-login URL (required for deployment)
APP_CORS_ALLOWED_ORIGINS=
APP_LOGIN_SUCCESS_URL=

# Google refresh token이 꼭 필요한 경우에만 true
OIDC_GOOGLE_OFFLINE_ACCESS=false

# Local HTTP backend: lax/false
# Local frontend -> HTTPS EC2 backend: none/true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
